<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
        Bold, high-contrast black camera glyph on the yellow background (ic_launcher_background).
        Content is kept within roughly x:20-88 / y:28-84, inside the ~66dp adaptive-icon safe
        zone (center 21-87 of the 108dp canvas), so it isn't clipped by circular/squircle/rounded
        -square launcher masks on different OEM skins. Simple, chunky shapes (thick body, one big
        lens ring) so it still reads as "a camera" at the tiny sizes launcher icons are shown at.
    -->

    <!-- Small raised viewfinder bump on top of the camera body -->
    <path
        android:fillColor="#231C00"
        android:pathData="M44,28 L64,28 L68,38 L40,38 Z" />

    <!-- Camera body (rounded rect, x:20-88, y:38-84) -->
    <path
        android:fillColor="#231C00"
        android:pathData="M28,38 L80,38 C84.42,38 88,41.58 88,46 L88,76 C88,80.42 84.42,84 80,84 L28,84 C23.58,84 20,80.42 20,76 L20,46 C20,41.58 23.58,38 28,38 Z" />

    <!-- Lens outer ring (cut back to the yellow background color) -->
    <path
        android:fillColor="#FFCD11"
        android:pathData="M54,63 m-16,0 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0" />

    <!-- Lens glass (black) -->
    <path
        android:fillColor="#231C00"
        android:pathData="M54,63 m-10,0 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0" />

    <!-- Lens highlight, for a bit of dimensionality -->
    <path
        android:fillColor="#FFCD11"
        android:pathData="M54,63 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0" />

    <!-- Shutter button -->
    <path
        android:fillColor="#FFCD11"
        android:pathData="M72,41 h8 v4 h-8 z" />
</vector>
